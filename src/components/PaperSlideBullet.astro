---
// src/components/PaperSlideBullet.astro
// 演示正文的一个 block: 大纲标题 / 列表项 / 独立公式行 / 散文段
//
// 2026-11-27 改造: 旧版是 3 种 bullet (title/definition/formula) + 2 行 clamp +
//   title 属性 hover 展开。clamp 会裁掉正文, hover 展开在触屏/键盘不可达,
//   因此改为按 block 类型输出语义元素, 完整呈现且不裁切。
import { markMath } from "../lib/slide-content.mjs";

interface Props {
  block: import("../lib/slide-content.mjs").SlideBlock;
}

const { block } = Astro.props;
// 独立公式行保留源文本 (源是 Unicode 符号 + LaTeX 下标混排, 拆开标记会破坏语义);
// 正文/标题里的数学 token 才包成 $...$ 交给 KaTeX auto-render。
const text = block.kind === "formula" ? block.text : markMath(block.text);
---
{block.kind === "item" && (
  <li class="slide-body-item">{text}</li>
)}
{block.kind === "heading" && (
  <p class="slide-body-block slide-body-heading">{text}</p>
)}
{block.kind === "paragraph" && (
  <p class="slide-body-block slide-body-paragraph">{text}</p>
)}
{block.kind === "formula" && (
  <p class="slide-body-block slide-body-formula">{text}</p>
)}
