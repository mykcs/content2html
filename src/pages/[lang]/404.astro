---
// src/pages/[lang]/404.astro - Bilingual 404 page
// i18n: zh (defaultLocale, /404/) + en (/en/404/)
// 用 inline locale strings (项目无 t() helper)
import "../../styles/global.css";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params;

const messages = {
  zh: {
    title: "404 - 页面未找到",
    heading: "404",
    message: "抱歉，访问的页面不存在。",
    back: "返回首页",
    homePath: "/zh/",
  },
  en: {
    title: "404 - Page Not Found",
    heading: "404",
    message: "Sorry, the page you're looking for doesn't exist.",
    back: "Back to Home",
    homePath: "/en/",
  },
};

const t = messages[lang as "zh" | "en"] ?? messages.zh;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = `${baseUrl}${t.homePath}`;

// Return real 404 status (static site: 仅靠浏览器识别)
Astro.response.status = 404;
---

<!doctype html>
<html lang={lang} data-design-system="content2html-20261120" data-page-role="message">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <title>{t.title}</title>
  </head>
  <body class="message-page">
    <main class="message" id="main">
      <h1>{t.heading}</h1>
      <p>{t.message}</p>
      <p><a href={homeUrl}>{t.back}</a></p>
    </main>
  </body>
</html>
