---
// Preserve the static redirect and a fully styled, accessible fallback.
import '../styles/global.css';
const target = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/zh/`;
---
<!doctype html>
<html lang="zh" data-design-system="content2html-20261120" data-page-role="redirect">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <title>content2html</title>
  </head>
  <body class="message-page">
    <main class="message" id="main">
      <h1>content2html</h1>
      <p>正在跳转到中文首页。</p>
      <p><a href={target}>继续访问</a></p>
    </main>
  </body>
</html>
