---
// src/pages/zh/paper/2603.12109/slide.astro
// paper-mode: 中文 slide (横向翻页)
//   1 标题 · 之后按 SEQUENCE 排布 Q1…Q7 与 4 张图 · 最后 1 页核心贡献
//
// v4.1 (2026-11-27): deck 计划 + 版式预算自动分页。
//   旧实现手写 sections_zh[3..7] 渲染 Q4.1/Q4.2/Q5/Q6/Q7, 实际显示的是
//   Q3.2/Q3.3/Q3.4/Q4.1/Q4.2 的内容, 且第 8-10 节从未出现; 正文又只取 "1. " 编号行,
//   于是 Q4.1/Q4.2/Q5 三张 slide 是空的。
//   现在: 计划在构建期校验 (每节恰好一次 + 顺序 + Q 编号与标题一致),
//   正文按 1920×1080 画布的可用高度自动切页, 每页都装得下且不丢行。
import DateText from "../../../../components/DateText.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { scholarlyArticleLd } from "../../../../lib/json-ld";
import { getKeyFormulasForSection } from "../../../../lib/paper-slide-template";
import { assertDeckPlan, cleanSectionHeading, deckKicker, resolveDeckSlide } from "../../../../lib/deck-plan.mjs";

import { splitSectionBlocks } from "../../../../lib/slide-content.mjs";
import PaperFigureSlide from "../../../../components/PaperFigureSlide.astro";
import PaperSlideSection from "../../../../components/PaperSlideSection.astro";

const entry = await getEntry("papers", "2603.12109");
if (!entry) throw new Error("paper 2603.12109 not found in collection");
const paper = entry.data as {
  arxiv_id?: string;
  title_zh: string;
  title_en: string;
  authors: string[];
  abstract_zh: string;
  abstract_en: string;
  sections_zh: { heading: string; body: string }[];
  sections_en: { heading: string; body: string }[];
  key_takeaways: string[];
  published_date?: string;
  code_url?: string;
  venue?: string;
  venue_rank?: string;
  venue_url?: string;
  field_large_zh?: string;
  field_medium_zh?: string;
  field_small_zh?: string;
  technologies_zh?: string[];
  key_formulas?: {
    section_index: number;
    label: { zh: string; en: string };
    formula: { zh: string; en: string };
    context?: { zh?: string; en?: string };
  }[];
};

const FIG = `${import.meta.env.BASE_URL}/figures/2603.12109`;
const paperId = paper.arxiv_id ?? entry.id;

// Deck 计划: 每节恰好一次, 顺序与论文一致, Q 编号与该节标题一致 (构建期校验)
/** @type {import("../../../../lib/deck-plan.mjs").DeckSlide[]} */
const PLAN = [
  { key: "Q1", label: "试图解决什么问题", section: 0 },
  { key: "Q2", label: "相关研究", section: 1 },
  { key: "Q3.1", label: "构建 AS 通道批评信号", section: 2 },
  { key: "Q3.2", label: "构建 BT 通道批评信号", section: 3 },
  { key: "Q3.3", label: "边际感知辅助目标", section: 4 },
  { key: "Q3.4", label: "最小侵入式优势重加权", section: 5 },
  { key: "Q4.1", label: "实验 (设置 + Table 1)", section: 6 },
  { key: "Q4.2", label: "实验 (动态 + 鲁棒性 + λ)", section: 7 },
  { key: "Q5", label: "进一步探索", section: 8 },
  { key: "Q6", label: "总结", section: 9 },
  { key: "Q7", label: "进一步了解", section: 10 },
];
assertDeckPlan(PLAN, paper.sections_zh);

// 每一节按版式预算切分成若干页正文
const sectionLayout = new Map<string, {
  slide: import("../../../../lib/deck-plan.mjs").DeckSlide;
  section: { heading: string; body: string };
  index: number;
  chunks: import("../../../../lib/slide-content.mjs").SlideBlockChunks;
}>();
for (const plan of PLAN) {
  const resolved = resolveDeckSlide(PLAN, paper.sections_zh, plan.key);
  const hasFormula = getKeyFormulasForSection(paper.key_formulas, resolved.index).length > 0;
  const { chunks } = splitSectionBlocks({
    heading: cleanSectionHeading(resolved.section.heading),
    body: resolved.section.body,
    hasFormula,
  });
  sectionLayout.set(plan.key, { slide: resolved.slide, section: resolved.section, index: resolved.index, chunks });
}

// 页面顺序: 标题页固定为 1, 之后按 SEQUENCE 排布, 最后是核心贡献
const FIGURES = {
  fig1: {
    kicker: "Figure 1 · 论文核心图",
    heading: "信息自锁 (SeL) 与 AReW 缓解",
    caption: "上: vanilla outcome-based RL 陷入自锁 (Uninformative AS + Anti-aligned BT); 下: AReW 通过方向性批评恢复 AS-BT 对齐 (Informative AS + Aligned BT)",
    layout: "single" as const,
    images: [{ src: `${FIG}/fig1_pipeline.png`, alt: "Fig 1: SeL overview + AReW mitigation", frame: "r-2x1 fit-contain flex-1" }],
  },
  fig4: {
    kicker: "Figure 4 · 训练动态 4 tasks",
    heading: "训练动态结果",
    caption: "vanilla PPO (红) vs AReW-AS ONLY (绿) vs AReW-AS+BT (蓝) Reward vs Training Steps; AReW 持续提升, vanilla 停滞",
    layout: "single" as const,
    images: [{ src: `${FIG}/fig4_full.png`, alt: "Fig 4: training dynamics", frame: "r-16x10 fit-contain flex-1" }],
  },
  fig3: {
    kicker: "Figure 3 · 跨 RL 算法泛化",
    heading: "PPO / GRPO / GSPO 三算法一致提升",
    caption: "(a) MediQ 干预: outcome-RL 削弱反馈敏感性, 提升 belief consistency; (b) PE-F 在 GRPO; (c) FloDial-Easy 在 GSPO",
    layout: "single" as const,
    images: [{ src: `${FIG}/fig3_full.png`, alt: "Fig 3: algorithm generalization", frame: "h-30 fit-contain" }],
  },
  fig5: {
    kicker: "Figures 5+6 · 鲁棒性 + 真实场景",
    heading: "λ 重加权与跨场景泛化",
    caption: "图 5 (左): τ²-bench 训练动态 (a) reward (b) tool error (c) response token (d) instruction turn · 图 6 (右): τ²-bench AReW 客服场景",
    layout: "pair" as const,
    images: [
      { src: `${FIG}/fig5_taubench.png`, alt: "Fig 5: τ²-bench training dynamics — (a) rewards (b) tool execution errors (c) consumed response tokens (d) instruction turns", frame: "h-30 fit-contain" },
      { src: `${FIG}/gh-tau2-AREW.png`, alt: "Fig 6: τ²-bench AReW customer service", frame: "h-30 fit-contain" },
    ],
  },
};

const SEQUENCE: Array<{ kind: "figure"; id: keyof typeof FIGURES } | { kind: "section"; key: string }> = [
  { kind: "figure", id: "fig1" },
  { kind: "section", key: "Q1" },
  { kind: "section", key: "Q2" },
  { kind: "section", key: "Q3.1" },
  { kind: "section", key: "Q3.2" },
  { kind: "section", key: "Q3.3" },
  { kind: "section", key: "Q3.4" },
  { kind: "figure", id: "fig4" },
  { kind: "section", key: "Q4.1" },
  { kind: "figure", id: "fig3" },
  { kind: "section", key: "Q4.2" },
  { kind: "figure", id: "fig5" },
  { kind: "section", key: "Q5" },
  { kind: "section", key: "Q6" },
  { kind: "section", key: "Q7" },
];

type SlideEntry =
  | { kind: "figure"; page: number; figure: (typeof FIGURES)[keyof typeof FIGURES] }
  | {
      kind: "section";
      page: number;
      section: { heading: string; body: string };
      chunk: import("../../../../lib/slide-content.mjs").SlideBlockChunk;
      index: number;
      kicker: string;
    };

const SLIDES: SlideEntry[] = [];
let nextPage = 2;
for (const slot of SEQUENCE) {
  if (slot.kind === "figure") {
    SLIDES.push({ kind: "figure", page: nextPage, figure: FIGURES[slot.id] });
    nextPage += 1;
  } else {
    const layout = sectionLayout.get(slot.key)!;
    const total = layout.chunks.length;
    layout.chunks.forEach((chunk, index) => {
      SLIDES.push({
        kind: "section",
        page: nextPage,
        section: layout.section,
        chunk,
        index: layout.index,
        kicker: total > 1 ? `${deckKicker(layout.slide)} (${index + 1}/${total})` : deckKicker(layout.slide),
      });
      nextPage += 1;
    });
  }
}
const TOTAL_SLIDES = nextPage;
const meta = (page: number) => `${String(page).padStart(2, "0")} / ${String(TOTAL_SLIDES).padStart(2, "0")}`;
---
<BaseLayout
  title={`${paper.title_zh} | paper-slide`}
  description={paper.abstract_zh}
  lang="zh"
  productType="slide"
  jsonLd={scholarlyArticleLd(paper, "zh", entry.id)}
>
  <!-- Slide 1: Title + Info Corner -->
  <section class="slide-page active" data-page="1">
    <div class="slide-top-accent"></div>
    <div class="slide-meta-bar">
      <span class="meta-page">{meta(1)}</span>
    </div>

    <div class="col-span-12 flex flex-col justify-center items-center text-center gap-6">
      <hr class="accent-bar" />
      <h1 class="text-headline font-sans font-bold leading-tight max-w-slide-title">{paper.title_zh}</h1>
      <hr class="swiss-rule w-40" />
      <p class="text-body leading-relaxed max-w-slide-title">{paper.authors.join(" · ")}</p>
    </div>

    <!-- Slide 1 左下角元信息块: arxiv / 发布日期 / 代码 / 领域 / 技术 -->
    <aside class="slide-info-corner" aria-label="Paper metadata">
      <dl>
        <dt>arXiv</dt>
        <dd><a href={`https://arxiv.org/abs/${paperId}`} target="_blank" rel="noopener noreferrer">{paperId}</a></dd>
        <dt>Published</dt>
        <dd>{paper.published_date ? <DateText value={paper.published_date} lang="zh" /> : "暂无"}</dd>
        <dt>Code</dt>
        <dd>
          {paper.code_url
            ? <a href={paper.code_url} target="_blank" rel="noopener noreferrer">{paper.code_url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")}</a>
            : <span>暂无</span>}
        </dd>
        <dt>Venue</dt>
        <dd>
          {paper.venue_url
            ? <a href={paper.venue_url} target="_blank" rel="noopener noreferrer">{paper.venue ?? "—"}</a>
            : <>{paper.venue ?? "—"}</>}
          {paper.venue_rank && <span class="venue-rank">({paper.venue_rank})</span>}
        </dd>
        <dt>Field</dt>
        <dd>{paper.field_large_zh ?? "—"} / {paper.field_medium_zh ?? "—"} / {paper.field_small_zh ?? "—"}</dd>
        <dt>Tech</dt>
        <dd>{(paper.technologies_zh ?? []).join(" · ") || "—"}</dd>
      </dl>
    </aside>
  </section>

  {SLIDES.map((slide) =>
    slide.kind === "figure" ? (
      <PaperFigureSlide
        page={slide.page}
        total={TOTAL_SLIDES}
        kicker={slide.figure.kicker}
        heading={slide.figure.heading}
        caption={slide.figure.caption}
        images={slide.figure.images}
        layout={slide.figure.layout}
      />
    ) : (
      <section class="slide-page" data-page={String(slide.page)}>
        <div class="slide-top-accent"></div>
        <div class="slide-meta-bar">
          <span class="meta-page">{meta(slide.page)}</span>
        </div>
        <div class="col-span-12 flex flex-col gap-5 h-full">
          <PaperSlideSection
            section={slide.section}
            blocks={slide.chunk}
            sectionIndex={slide.index}
            keyFormulas={paper.key_formulas}
            lang="zh"
            kicker={slide.kicker}
          />
        </div>
      </section>
    )
  )}

  <!-- 核心贡献 -->
  <section class="slide-page" data-page={String(TOTAL_SLIDES)}>
    <div class="slide-top-accent"></div>
    <div class="slide-meta-bar">
      <span class="meta-page">{meta(TOTAL_SLIDES)}</span>
    </div>

    <div class="col-span-12 flex flex-col gap-5 h-full">
      <div>
        <p class="text-kicker mb-3">Key Takeaways · 核心贡献</p>
        <hr class="accent-bar mb-6" />
        <h2 class="text-headline font-sans font-bold">核心贡献</h2>
      </div>
      <ul class="flex-1 flex flex-col gap-3 justify-center max-w-slide-heading">
        {paper.key_takeaways.map((t) => (
          <li class="takeaway-item">{t}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
