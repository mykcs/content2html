---
// src/pages/en/paper/2603.12109/slide.astro
// paper-mode: English slide (horizontal pagination)
//   1 Title · then SEQUENCE (Q1…Q7 and 4 figures) · last page Key takeaways
//
// v4.1 (2026-11-27): deck plan + automatic pagination by the canvas budget.
//   The old template rendered sections_en[3..7] for the Q4.1/Q4.2/Q5/Q6/Q7 slides,
//   which actually showed Q3.2/Q3.3/Q3.4/Q4.1/Q4.2, and sections 8-10 never
//   appeared. It also kept only "N. " lines, so Q4.1/Q4.2/Q5 rendered empty.
import DateText from "../../../../components/DateText.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { scholarlyArticleLd } from "../../../../lib/json-ld";
import { getKeyFormulasForSection } from "../../../../lib/paper-slide-template";
import { assertDeckPlan, cleanSectionHeading, deckKicker, resolveDeckSlide } from "../../../../lib/deck-plan.mjs";

import { splitSectionBlocks } from "../../../../lib/slide-content.mjs";
import PaperFigureSlide from "../../../../components/PaperFigureSlide.astro";
import PaperSlideSection from "../../../../components/PaperSlideSection.astro";

const entry = await getEntry("papers", "2603.12109");
if (!entry) throw new Error("paper 2603.12109 not found in collection");
const paper = entry.data as {
  arxiv_id?: string;
  title_zh: string;
  title_en: string;
  title_full_en?: string;
  authors: string[];
  authors_with_affil_en?: { name: string; affil: string[] }[];
  affiliations_en?: string[];
  abstract_zh: string;
  abstract_en: string;
  sections_zh: { heading: string; body: string }[];
  sections_en: { heading: string; body: string }[];
  key_takeaways: string[];
  published_date?: string;
  code_url?: string;
  venue?: string;
  venue_rank?: string;
  venue_url?: string;
  field_large_en?: string;
  field_medium_en?: string;
  field_small_en?: string;
  technologies_en?: string[];
  key_formulas?: {
    section_index: number;
    label: { zh: string; en: string };
    formula: { zh: string; en: string };
    context?: { zh?: string; en?: string };
  }[];
};

const FIG = `${import.meta.env.BASE_URL}/figures/2603.12109`;
const TITLE_EN = paper.title_full_en ?? paper.title_en;
const paperId = paper.arxiv_id ?? entry.id;
const AUTHORS_EN = paper.authors_with_affil_en ?? paper.authors.map((n) => ({ name: n, affil: [] as string[] }));
const AFFILS_EN: string[] = paper.affiliations_en ?? Array.from(new Set(AUTHORS_EN.flatMap((a) => a.affil)));

// Deck plan: every section exactly once, paper order, Q number matches the heading
/** @type {import("../../../../lib/deck-plan.mjs").DeckSlide[]} */
const PLAN = [
  { key: "Q1", label: "Problem", section: 0 },
  { key: "Q2", label: "Related Work", section: 1 },
  { key: "Q3.1", label: "AS channel critique signal", section: 2 },
  { key: "Q3.2", label: "BT channel critique signal", section: 3 },
  { key: "Q3.3", label: "Margin-aware auxiliary objective", section: 4 },
  { key: "Q3.4", label: "Minimum-invasive advantage reweighting", section: 5 },
  { key: "Q4.1", label: "Experiments (Setup + Table 1)", section: 6 },
  { key: "Q4.2", label: "Experiments (Dynamics + Robustness + λ)", section: 7 },
  { key: "Q5", label: "Future Work", section: 8 },
  { key: "Q6", label: "Summary", section: 9 },
  { key: "Q7", label: "Learn More", section: 10 },
];
assertDeckPlan(PLAN, paper.sections_en);

const sectionLayout = new Map<string, {
  slide: import("../../../../lib/deck-plan.mjs").DeckSlide;
  section: { heading: string; body: string };
  index: number;
  chunks: import("../../../../lib/slide-content.mjs").SlideBlockChunks;
}>();
for (const plan of PLAN) {
  const resolved = resolveDeckSlide(PLAN, paper.sections_en, plan.key);
  const hasFormula = getKeyFormulasForSection(paper.key_formulas, resolved.index).length > 0;
  const { chunks } = splitSectionBlocks({
    heading: cleanSectionHeading(resolved.section.heading),
    body: resolved.section.body,
    hasFormula,
  });
  sectionLayout.set(plan.key, { slide: resolved.slide, section: resolved.section, index: resolved.index, chunks });
}

const FIGURES = {
  fig1: {
    kicker: "Figure 1 · Core Diagram",
    heading: "Information Self-Locking (SeL) and AReW Mitigation",
    caption: "Top: vanilla outcome-based RL trapped in self-locking (Uninformative AS + Anti-aligned BT); Bottom: AReW restores AS-BT alignment via directional critiques (Informative AS + Aligned BT)",
    layout: "single" as const,
    images: [{ src: `${FIG}/fig1_pipeline.png`, alt: "Fig 1: SeL overview + AReW mitigation", frame: "r-2x1 fit-contain flex-1" }],
  },
  fig4: {
    kicker: "Figure 4 · Training Dynamics (4 tasks)",
    heading: "Training Dynamics Results",
    caption: "vanilla PPO (red) vs AReW-AS ONLY (green) vs AReW-AS+BT (blue) Reward vs Training Steps; AReW sustained improvement, vanilla stalls",
    layout: "single" as const,
    images: [{ src: `${FIG}/fig4_full.png`, alt: "Fig 4: training dynamics", frame: "r-16x10 fit-contain flex-1" }],
  },
  fig3: {
    kicker: "Figure 3 · Cross-Algorithm Generalization",
    heading: "PPO / GRPO / GSPO — Consistent Gains",
    caption: "(a) MediQ intervention: outcome-RL reduces feedback sensitivity, increases belief consistency; (b) PE-F under GRPO; (c) FloDial-Easy under GSPO",
    layout: "single" as const,
    images: [{ src: `${FIG}/fig3_full.png`, alt: "Fig 3: algorithm generalization", frame: "h-30 fit-contain" }],
  },
  fig5: {
    kicker: "Figures 5+6 · Robustness + Real Scenario",
    heading: "λ Reweighting Strength and Cross-Scenario Generalization",
    caption: "Fig 5 (left): τ²-bench training dynamics — (a) rewards (b) tool execution errors (c) consumed response tokens (d) instruction turns · Fig 6 (right): τ²-bench AReW customer service",
    layout: "pair" as const,
    images: [
      { src: `${FIG}/fig5_taubench.png`, alt: "Fig 5: τ²-bench training dynamics — (a) rewards (b) tool execution errors (c) consumed response tokens (d) instruction turns", frame: "h-30 fit-contain" },
      { src: `${FIG}/gh-tau2-AREW.png`, alt: "Fig 6: τ²-bench AReW customer service", frame: "h-30 fit-contain" },
    ],
  },
};

const SEQUENCE: Array<{ kind: "figure"; id: keyof typeof FIGURES } | { kind: "section"; key: string }> = [
  { kind: "figure", id: "fig1" },
  { kind: "section", key: "Q1" },
  { kind: "section", key: "Q2" },
  { kind: "section", key: "Q3.1" },
  { kind: "section", key: "Q3.2" },
  { kind: "section", key: "Q3.3" },
  { kind: "section", key: "Q3.4" },
  { kind: "figure", id: "fig4" },
  { kind: "section", key: "Q4.1" },
  { kind: "figure", id: "fig3" },
  { kind: "section", key: "Q4.2" },
  { kind: "figure", id: "fig5" },
  { kind: "section", key: "Q5" },
  { kind: "section", key: "Q6" },
  { kind: "section", key: "Q7" },
];

type SlideEntry =
  | { kind: "figure"; page: number; figure: (typeof FIGURES)[keyof typeof FIGURES] }
  | {
      kind: "section";
      page: number;
      section: { heading: string; body: string };
      chunk: import("../../../../lib/slide-content.mjs").SlideBlockChunk;
      index: number;
      kicker: string;
    };

const SLIDES: SlideEntry[] = [];
let nextPage = 2;
for (const slot of SEQUENCE) {
  if (slot.kind === "figure") {
    SLIDES.push({ kind: "figure", page: nextPage, figure: FIGURES[slot.id] });
    nextPage += 1;
  } else {
    const layout = sectionLayout.get(slot.key)!;
    const total = layout.chunks.length;
    layout.chunks.forEach((chunk, index) => {
      SLIDES.push({
        kind: "section",
        page: nextPage,
        section: layout.section,
        chunk,
        index: layout.index,
        kicker: total > 1 ? `${deckKicker(layout.slide)} (${index + 1}/${total})` : deckKicker(layout.slide),
      });
      nextPage += 1;
    });
  }
}
const TOTAL_SLIDES = nextPage;
const meta = (page: number) => `${String(page).padStart(2, "0")} / ${String(TOTAL_SLIDES).padStart(2, "0")}`;
---
<BaseLayout
  title={`${paper.title_en} | paper-slide`}
  description={paper.abstract_en}
  lang="en"
  productType="slide"
  jsonLd={scholarlyArticleLd(paper, "en", entry.id)}
>
  <!-- Slide 1: Title (full English title + English authors + English affiliations) -->
  <section class="slide-page active" data-page="1">
    <div class="slide-top-accent"></div>
    <div class="slide-meta-bar">
      <span class="meta-page">{meta(1)}</span>
    </div>

    <div class="col-span-12 flex flex-col justify-center items-center text-center gap-6">
      <hr class="accent-bar" />
      <h1 class="text-headline font-sans font-bold leading-tight max-w-slide-title">{TITLE_EN}</h1>
      <hr class="swiss-rule w-40" />
      <p class="text-body leading-relaxed max-w-slide-title">
        {AUTHORS_EN.map((a, i) => <><span class="author-name">{a.name}</span><sup class="text-caption text-ikb-blue">{a.affil.map((x) => String(AFFILS_EN.indexOf(x) + 1)).join(",")}</sup>{i < AUTHORS_EN.length - 1 ? " · " : ""}</>)}
      </p>
      <ol class="text-caption text-graphite leading-relaxed list-none max-w-slide-title text-left mt-2">
        {AFFILS_EN.map((aff, idx) => <li><sup class="text-ikb-blue font-semibold">{idx + 1}</sup> {aff}</li>)}
      </ol>
    </div>

    <!-- Slide 1 right-bottom metadata corner: arxiv / publish date / code / fields / techs -->
    <aside class="slide-info-corner" aria-label="Paper metadata">
      <dl>
        <dt>arXiv</dt>
        <dd><a href={`https://arxiv.org/abs/${paperId}`} target="_blank" rel="noopener noreferrer">{paperId}</a></dd>
        <dt>Published</dt>
        <dd>{paper.published_date ? <DateText value={paper.published_date} lang="en" /> : "N/A"}</dd>
        <dt>Code</dt>
        <dd>
          {paper.code_url
            ? <a href={paper.code_url} target="_blank" rel="noopener noreferrer">{paper.code_url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")}</a>
            : <span>N/A</span>}
        </dd>
        <dt>Venue</dt>
        <dd>
          {paper.venue_url
            ? <a href={paper.venue_url} target="_blank" rel="noopener noreferrer">{paper.venue ?? "—"}</a>
            : <>{paper.venue ?? "—"}</>}
          {paper.venue_rank && <span class="venue-rank">({paper.venue_rank})</span>}
        </dd>
        <dt>Field</dt>
        <dd>{paper.field_large_en ?? "—"} / {paper.field_medium_en ?? "—"} / {paper.field_small_en ?? "—"}</dd>
        <dt>Tech</dt>
        <dd>{(paper.technologies_en ?? []).join(" · ") || "—"}</dd>
      </dl>
    </aside>
  </section>

  {SLIDES.map((slide) =>
    slide.kind === "figure" ? (
      <PaperFigureSlide
        page={slide.page}
        total={TOTAL_SLIDES}
        kicker={slide.figure.kicker}
        heading={slide.figure.heading}
        caption={slide.figure.caption}
        images={slide.figure.images}
        layout={slide.figure.layout}
      />
    ) : (
      <section class="slide-page" data-page={String(slide.page)}>
        <div class="slide-top-accent"></div>
        <div class="slide-meta-bar">
          <span class="meta-page">{meta(slide.page)}</span>
        </div>
        <div class="col-span-12 flex flex-col gap-5 h-full">
          <PaperSlideSection
            section={slide.section}
            blocks={slide.chunk}
            sectionIndex={slide.index}
            keyFormulas={paper.key_formulas}
            lang="en"
            kicker={slide.kicker}
          />
        </div>
      </section>
    )
  )}

  <!-- Key takeaways -->
  <section class="slide-page" data-page={String(TOTAL_SLIDES)}>
    <div class="slide-top-accent"></div>
    <div class="slide-meta-bar">
      <span class="meta-page">{meta(TOTAL_SLIDES)}</span>
    </div>

    <div class="col-span-12 flex flex-col gap-5 h-full">
      <div>
        <p class="text-kicker mb-3">Key Takeaways · Core contributions</p>
        <hr class="accent-bar mb-6" />
        <h2 class="text-headline font-sans font-bold">Core contributions</h2>
      </div>
      <ul class="flex-1 flex flex-col gap-3 justify-center max-w-slide-heading">
        {paper.key_takeaways.map((t) => (
          <li class="takeaway-item">{t}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
