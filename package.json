{
  "name": "content2html",
  "type": "module",
  "version": "0.1.0",
  "description": "\u5185\u5bb9 (arxiv paper / \u672c\u5730 progress) \u2192 HTML (slide + long-form). guizang Style B \u89c6\u89c9.",
  "private": true,
  "scripts": {
    "dev": "npm run styles:sync && astro dev",
    "build": "npm run styles:sync && node scripts/check-site-standards.mjs --source-only && astro check && astro build && npm run standards:check",
    "preview": "astro preview",
    "test": "playwright --version && node -e \"console.log('content2html: no jest tests; e2e via Playwright ad-hoc. See scripts/verify-print-e2e.mjs')\"",
    "astro": "astro",
    "styles:sync": "node scripts/sync-message-styles.mjs",
    "standards:check": "node scripts/check-site-standards.mjs",
    "test:standards": "node --test tests/site-standards.test.mjs",
    "test:standards:browser": "node scripts/verify-site-standards.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "4.1.18",
    "astro": "^6.4.2",
    "katex": "^0.16.47",
    "sharp": "^0.35.0",
    "tailwindcss": "4.1.18",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "playwright": "^1.61.0"
  },
  "overrides": {
    "yaml": "^2.8.4",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "svgo": "^4.0.2"
  }
}
